{
  "name": "figma-mirror-mcp",
  "description": "A free local-first Figma mirror and MCP server by Vantalogics.",
  "license": "MIT",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "private": true,
  "scripts": {
    "dev": "bun run --parallel dev:api dev:plugin",
    "dev:api": "bun run --cwd apps/api dev",
    "dev:plugin": "bun run --cwd apps/plugin dev",
    "dev:mcp": "bun run --cwd apps/mcp dev",
    "build": "bun run --workspaces --if-present build",
    "typecheck": "bun run --workspaces --if-present typecheck",
    "test": "bun test",
    "db:generate": "bun run --cwd apps/api db:generate",
    "db:migrate": "bun run --cwd apps/api db:migrate"
  },
  "devDependencies": {
    "@figma/plugin-typings": "^1.133.0",
    "@types/bun": "1",
    "drizzle-kit": "^0.31.10",
    "typescript": "^7.0.2"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "drizzle-orm": "^0.45.2",
    "zod": "^4.4.3"
  }
}
