{
  "name": "@figma-mirror/api",
  "type": "module",
  "scripts": {
    "dev": "bun --env-file=../../.env --watch src/main.ts",
    "start": "bun --env-file=../../.env src/main.ts",
    "build": "bun build src/main.ts --target bun --outdir dist",
    "typecheck": "tsc",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "bun --env-file=../../.env src/db/migrate.ts"
  },
  "devDependencies": {
    "@types/bun": "1",
    "typescript": "^7.0.2"
  },
  "dependencies": {
    "@figma-mirror/shared": "workspace:*",
    "drizzle-orm": "^0.45.2",
    "elysia": "1",
    "zod": "^4.4.3"
  }
}
